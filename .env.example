# ─────────────────────────────────────────────────────────────
# KDU GROUP — Field Extension Officer & Admin Portal
# Copy this file to `.env` and fill in your real values.
# NEVER commit the real `.env` (it is git-ignored).
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas connection string (REQUIRED in production / Vercel)
# Get it from: MongoDB Atlas → Cluster → Connect → Drivers → Node.js
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.y6ylolc.mongodb.net/myFirstDatabase?retryWrites=true&w=majority

# Legacy local PostgreSQL — only used by the optional offline
# seed / migration scripts in src/db (seed.ts, migrate-*.ts).
# Not required when running on MongoDB Atlas.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
